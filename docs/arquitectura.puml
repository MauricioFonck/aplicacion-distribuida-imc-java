@startuml
skinparam componentStyle rectangle
actor Usuario
component "Cliente Swing" as Cliente
component "PorcionesClient" as AdaptadorCliente
component "Registro RMI\n:1099" as Registro
component "PorcionesRemoteImpl" as Servicio
component "Estimacion\nDominio" as Dominio
Usuario --> Cliente : ingresa datos
Cliente --> AdaptadorCliente : SwingWorker
AdaptadorCliente --> Registro : lookup(PorcionesService)
AdaptadorCliente --> Servicio : conectar / calcular / desconectar
Servicio --> Dominio : valida y calcula
Dominio --> Servicio : PorcionesResponse
Servicio --> AdaptadorCliente : DTO serializable
@enduml
