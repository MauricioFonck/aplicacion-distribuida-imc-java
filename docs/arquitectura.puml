@startuml
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial

actor "Organizador" as user
component "Cliente de porciones\nClientWindow + PorcionesClient" as client
component "Protocolo compartido\nPorcionesProtocol" as protocol
component "Servidor de porciones\nServerWindow + PorcionesServer" as server
component "Calculo de dominio\nPorcionesCalculator" as calculator

user --> client : Ingresa IP, puerto, personas y porciones por persona
client --> protocol : Serializa solicitud
protocol --> server : TCP\nint personas + int porciones por persona
server --> calculator : Calcula el total de porciones
calculator --> server : valido + total + mensaje
server --> protocol : Serializa respuesta
protocol --> client : TCP\nboolean valido + long total + UTF mensaje
client --> user : Muestra el total y la reserva sugerida

@enduml
